{
  "name": "resolvedesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ResolveDesk - College Complaint Management System",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "build": "cd server && npm install",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "format": "npm run format --workspace=server && npm run format --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
